#!/bin/sh
# meepo — the command-line door into Meepo (linked into PATH by the Homebrew cask).
#   meepo           open Meepo
#   meepo <folder>  add the folder as a project (if new) and open a Claude session in it; `meepo .` = here
if [ $# -eq 0 ]; then exec open -a Meepo; fi
case "$1" in -h|--help) sed -n '2,4s/^# \{0,1\}//p' "$0"; exit 0 ;; esac
dir=$(cd "$1" 2>/dev/null && pwd -P) || { echo "meepo: no such folder: $1" >&2; exit 1; }
# Percent-encode every byte but the safe ones, so spaces and non-Latin names survive the URL.
path=$(printf '%s' "$dir" | perl -pe 's/([^A-Za-z0-9_.~\/-])/sprintf("%%%02X", ord($1))/ge')
exec open "meepo://open?path=$path"
